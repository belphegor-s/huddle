# Copy to .env. Only the first two lines have to be right to boot.

DATABASE_URL=postgres://huddle:huddle@localhost:5432/huddle
PUBLIC_URL=http://localhost:3000
# The API port. During development the client proxy reads this too, so moving
# off 3000 because something else has it is this one line.
PORT=3000
# The built client, served from the same origin as the API. Absolute, or
# relative to wherever the process starts. Leave empty to run API only.
WEB_DIR=

# Attachments and voice notes. Any S3 compatible bucket: AWS, Cloudflare R2,
# Backblaze B2, Wasabi, DigitalOcean Spaces, a MinIO you already run.
# Leave S3_ENDPOINT empty for AWS itself.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=huddle
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS wants virtual host addressing, most self hosted gateways want path style.
S3_FORCE_PATH_STYLE=false

# Sign in emails. With this empty, the link is printed to the log instead,
# which is enough to get in on a laptop.
SMTP_URL=
EMAIL_FROM=huddle <no-reply@localhost>

# Optional, and off unless set. Any OpenAI compatible endpoint, including a
# local Ollama. Nothing is sent anywhere while this is empty.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Web push. Generate a pair with:
#   pnpm --filter @huddle/server exec web-push generate-vapid-keys
# The public key is served to the browser, the private key never leaves here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How a push service reaches whoever runs this instance. A mailto: address or
# an https: URL, nothing else. Defaults to PUBLIC_URL, which only works once
# that is https, so local testing wants a mailto here.
VAPID_SUBJECT=mailto:admin@localhost

# Huddles work with nothing set here: two browsers that can reach each other
# connect directly. A relay is what gets a call through a strict NAT, where
# neither end is reachable from outside. Run your own, usually coturn. There is
# no default public STUN server on purpose, because that would be a request
# from the client to a third party.
TURN_URLS=
# Preferred. coturn started with `use-auth-secret` shares this, and huddle
# hands each caller a credential that stops working within the hour.
TURN_SECRET=
# Or a fixed pair, if the relay is configured with static credentials.
TURN_USERNAME=
TURN_PASSWORD=
# TURN_TTL_SECONDS=3600

# Sign in links allowed per hour from one address. The default suits a team
# behind a single NAT address. Lower it on an instance open to the internet.
# MAGIC_LINKS_PER_HOUR_PER_IP=100

# Set only when running more than one app instance behind a load balancer.
# HUDDLE_CLUSTER=true
