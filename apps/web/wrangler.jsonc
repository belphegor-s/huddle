{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huddle-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./build/client"
  }
}
