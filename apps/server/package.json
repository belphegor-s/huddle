{
  "name": "@huddle/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --external:pg-native --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@huddle/core": "workspace:*",
    "@huddle/db": "workspace:*",
    "@huddle/server": "workspace:*",
    "hono": "^4.12.32",
    "react-router": "^8.3.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@huddle/web": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
