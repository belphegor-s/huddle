{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // Test only. The deployable Worker is apps/web. This config exists so the
  // Durable Objects can be exercised in real workerd next to the code they
  // belong to, rather than from whichever app happens to import them.
  "name": "huddle-adapter-cloudflare-test",
  "main": "./test/worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "PUBLIC_URL": "http://localhost:8787",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huddle",
      "database_id": "local",
      "migrations_dir": "../db/migrations",
    },
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "local",
    },
  ],

  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "huddle-blobs",
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_ROOM", "class_name": "ChannelRoom" },
      { "name": "RATE_COUNTER", "class_name": "RateCounter" },
    ],
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChannelRoom", "RateCounter"],
    },
  ],
}
